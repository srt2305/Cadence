# Which provider to use. Any OpenAI-compatible endpoint works.
#   groq        free, no card needed        https://console.groq.com/keys
#   gemini      free tier                   https://aistudio.google.com/apikey
#   openai      paid                        https://platform.openai.com/api-keys
#   openrouter  free models, 50 req/day     https://openrouter.ai/keys
CADENCE_PROVIDER=groq

# Set the one matching your provider above. Leave the others blank.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Runs per scenario. Below 2 is not evidence: these models are not
# deterministic even at temperature 0.
CADENCE_REPEATS=3

# Optional overrides.
# CADENCE_MODEL=            pin one model instead of the provider's default chain
# CADENCE_WORKERS=4         scenarios evaluated in parallel
# CADENCE_RPM=28            requests per minute ceiling
# CADENCE_SCRIPTED=1        0 uses an LLM patient instead of fixed scripts
# CADENCE_FALLBACKS=1       0 pins one model, failing loudly instead of switching
